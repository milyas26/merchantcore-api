{
  "name": "merchantcore-api",
  "version": "1.0.0",
  "description": "MerchantCore Ecommerce API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register src/server.ts",
    "build": "tsc && tsc-alias -p tsconfig.json",
    "start": "node dist/server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset",
    "db:studio": "prisma studio",
    "prisma:generate:public": "cd prisma/public && npx prisma generate",
    "prisma:generate:store": "cd prisma/store && npx prisma generate",
    "prisma:generate:all": "npm run prisma:generate:public && npm run prisma:generate:store",
    "prisma:migrate:dev:public": "cd prisma/public && npx prisma migrate dev",
    "prisma:migrate:dev:store": "cd prisma/store && npx prisma migrate dev",
    "prisma:migrate:dev:all": "npm run prisma:migrate:dev:public && npm run prisma:migrate:dev:store",
    "prisma:migrate:deploy:public": "cd prisma/public && npx prisma migrate deploy",
    "prisma:migrate:deploy:store": "cd prisma/store && npx prisma migrate deploy",
    "prisma:migrate:deploy:all": "npm run prisma:migrate:deploy:public && npm run prisma:migrate:deploy:store",
    "prisma:reset:public": "cd prisma/public && npx prisma migrate reset",
    "prisma:reset:store": "cd prisma/store && npx prisma migrate reset",
    "prisma:studio:public": "cd prisma/public && npx prisma studio",
    "prisma:studio:store": "cd prisma/store && npx prisma studio",
    "setup:multi-schema": "npx tsx scripts/setup-migrations.ts",
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:check": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix"
  },
  "keywords": [
    "ecommerce",
    "api",
    "fastify",
    "prisma"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/env": "^5.0.3",
    "@fastify/jwt": "^10.0.0",
    "@fastify/swagger": "^9.6.1",
    "@fastify/swagger-ui": "^5.2.3",
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.4.7",
    "fastify": "^5.6.2",
    "fastify-plugin": "^5.1.0",
    "prisma": "^6.19.0",
    "zod": "^3.24.2",
    "zod-to-json-schema": "^3.24.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.10.1",
    "@typescript-eslint/eslint-plugin": "^8.46.4",
    "@typescript-eslint/parser": "^8.46.4",
    "eslint": "^9.39.1",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  }
}
