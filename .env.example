# Database URLs for multi-schema setup
# Base connection URL (without schema parameter)
DATABASE_URL_BASE=postgresql://username:password@localhost:5432/merchantcore

# Public schema (users, stores, memberships)
DATABASE_URL_PUBLIC=postgresql://username:password@localhost:5432/merchantcore?schema=public

# Store schema template (used as base for per-store schemas)
DATABASE_URL_STORE=postgresql://username:password@localhost:5432/merchantcore?schema=store_template

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-refresh-secret-here
JWT_REFRESH_EXPIRES_IN=30d

# Server Configuration
NODE_ENV=development
PORT=3000
HOST=localhost

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_PRETTY=true